              <pitch>60</pitch>
              <tpc>14</tpc>
              <PartialTie>
                <partialSpannerDirection>incoming</partialSpannerDirection>
              </PartialTie>
              <LaissezVib />
            </Note>
          </Chord>
        </voice>
        <Marker>
          <text>LV landing</text>
          <label>lv-landing</label>
        </Marker>
      </Measure>
      <Measure>
