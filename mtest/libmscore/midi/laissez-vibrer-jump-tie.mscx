        <height>15</height>
        <Text>
          <style>Title</style>
          <text>Audio v0.10 - LV landing after a forward jump</text>
        </Text>
        <Text>
          <style>Subtitle</style>
          <size>10</size>
          <text>Modern FluidSynth. Jump from measure 1 directly to the labeled measure 3, skipping measure 2.
The C continues as one tied attack into the LV endpoint, then rings through rests.
This custom forward jump isolates playback from unrelated D.C./D.S. repeat choices.</text>
        </Text>
      </VBox>
      <Measure>
        <voice>
          <Clef>
            <concertClefType>G</concertClefType>
            <transposingClefType>G</transposingClefType>
          </Clef>
          <TimeSig>
            <sigN>4</sigN>
            <sigD>4</sigD>
          </TimeSig>
          <Chord>
            <durationType>whole</durationType>
            <Note>
              <pitch>60</pitch>
              <tpc>14</tpc>
              <PartialTie>
                <partialSpannerDirection>outgoing</partialSpannerDirection>
              </PartialTie>
            </Note>
          </Chord>
        </voice>
        <Jump>
          <text>To LV landing</text>
          <jumpTo>lv-landing</jumpTo>
          <playUntil>end</playUntil>
          <continueAt />
          <playRepeats>0</playRepeats>
        </Jump>
      </Measure>
      <Measure>
        <voice>
          <Rest>
            <durationType>measure</durationType>
            <duration>1/1</duration>
          </Rest>
        </voice>
      </Measure>
      <Measure>
