#!/bin/sh

echo "TRANSLATIONS = \\"
uis=`find $1/share/locale/ -name "mscore_*.ts"`
for a in $uis; do
      echo "    " $a \\;
      done
echo

echo "FORMS = \\"
uis=`find "$1" -type f -name "*.ui" ! -path "$1/build/*" ! -path "$1/builds/*"`
for a in $uis; do
      echo "    " $a \\;
      done
echo

echo "INCLUDEPATH = \\"
echo "    $1/libmscore \\"
echo "    $1/mscore \\"
echo

echo "SOURCES = \\"
uis=`find "$1" -type f -name "*.cpp" ! -path "$1/build/*" ! -path "$1/builds/*"`
for a in $uis; do
      echo "    " $a \\;
      done
echo

echo "RESOURCES = \\"
echo "    $1/mscore/qml.qrc \\"
echo "    $1/telemetry/telemetry_resources.qrc \\"
echo
