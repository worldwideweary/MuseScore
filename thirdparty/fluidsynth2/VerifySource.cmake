# Verify the checked-in source snapshot without requiring Python or a network.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/MANIFEST.sha256" entries ENCODING UTF-8)
set(count 0)
foreach(entry IN LISTS entries)
    string(SUBSTRING "${entry}" 0 64 expected)
    string(SUBSTRING "${entry}" 66 -1 relative)
    set(path "${CMAKE_CURRENT_LIST_DIR}/fluidsynth-2.3.4/${relative}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing FluidSynth source: ${relative}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Changed FluidSynth source: ${relative}")
    endif()
    math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
    message(FATAL_ERROR "FluidSynth source manifest is empty")
endif()
message(STATUS "Verified ${count} FluidSynth source files")
