       articulation-1 percussion-grace\
       drumset-1 drumset-2 drumset-3 drumset-4 drumset-5 drumset-6 drumset-7 drumset-8 \
       slashed_chord-layout-12 slashed_chord-layout-7 slashed_grace-3 slashed_noteheadposition-1\
