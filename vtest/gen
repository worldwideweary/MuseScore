#      layout-1 layout-2 layout-3 layout-4
#      system-4"

DPI=130

if [ -n "$VTEST_DIR" ]; then
# SRC env variable needed for Github action vtests
      echo "SRC=$SRC" >> $GITHUB_ENV
      DIR="$VTEST_DIR"
else
      DIR="$(cd "$(dirname "$0")" && pwd)"
fi
mkdir -p $DIR/html
cd $DIR/html
rm -f *.png

if test -f LOG; then
      rm LOG
      fi

# Prepare controlled inputs and an exact input manifest. Named profiles are
# fixture-specific; Studio comparisons also enable 37E modern beaming globally.
# Original external scores are never changed.
# Common style overrides are shared. 37E-only properties are deliberately
# omitted from the Studio prepared input.
echo "Prepare score inputs"
RAW_ARGS=""
BEAM_AB_ARGS=""
# Historical 3.x reference mode must continue to render exact tracked fixtures.
# Opt out of controlled overrides in Studio mode if an untouched comparison is
# needed. External source files remain unmodified in all modes.
if [ "$VTEST_PROFILE_MODE" = "raw" ]; then
      RAW_ARGS="--raw"
fi
if [ "$VTEST_BEAM_AB" = "1" ] && [ "$RUN_MODERN" = "1" ] && [ "$VTEST_PROFILE_MODE" != "raw" ]; then
      BEAM_AB_ARGS="--beam-ab"
fi
if [ -n "$EXTERNAL_MAP" ]; then
      python3 "$SCRIPT_DIR/prepare-inputs.py" \
            --scores-dir "$DIR" --html-dir "$DIR/html" \
            --config "$SCRIPT_DIR/engraving-profiles.json" $RAW_ARGS $BEAM_AB_ARGS \
            --external-map "$EXTERNAL_MAP" $SRC || exit 1
elif [ -n "$EXTERNAL_SCORE" ]; then
      python3 "$SCRIPT_DIR/prepare-inputs.py" \
            --scores-dir "$DIR" --html-dir "$DIR/html" \
            --config "$SCRIPT_DIR/engraving-profiles.json" $RAW_ARGS $BEAM_AB_ARGS \
            --external "$EXTERNAL_SCORE" $SRC || exit 1
else
      python3 "$SCRIPT_DIR/prepare-inputs.py" \
            --scores-dir "$DIR" --html-dir "$DIR/html" \
            --config "$SCRIPT_DIR/engraving-profiles.json" $RAW_ARGS $BEAM_AB_ARGS $SRC || exit 1
fi
JSON_FILE=vtestjob.json
INPUT_MANIFEST="$DIR/html/input-manifest.json"

REFRESH_ARGS=""
if [ "$VTEST_REFRESH_REFERENCES" = "1" ]; then
      REFRESH_ARGS="--refresh-cache"
fi

echo "Generate PNG files"
# run the mtests in "minimal" platform for headless systems
# enable fonts handling
#export QT_QPA_PLATFORM=minimal:enablefonts
if ! "$MSCORE" -j "$JSON_FILE" -r "$DPI" >LOG 2>&1; then
      cat LOG
      echo "ERROR: 37E rendering failed; no comparison or baseline published" >&2
      exit 1
fi
for src in $SRC; do
      if [ ! -s "$src-1.png" ]; then
            echo "ERROR: 37E did not render page 1 for $src (see html/LOG)" >&2
            exit 1
      fi
done

# Explicit, opt-in snapshot of the current 37E rendering for later PR comparisons.
# Never overwrite a baseline in an ordinary ./gen invocation.
if [ "$VTEST_CAPTURE_BASELINE" = "1" ]; then
      python3 "$SCRIPT_DIR/capture-baseline.py" \
            --renderer "$MSCORE" --scores-dir "$DIR" \
            --html-dir "$DIR/html" --baseline-dir "$DIR/baselines/37e" \
            --dpi "$DPI" --inputs-manifest "$INPUT_MANIFEST" $SRC || exit 1
fi

echo "LOG:"
cat LOG
echo "========"

if [ "$VTEST_GEN_METADATA" = "1" ]
then
    git branch --sort=-committerdate --format="%(refname:short) %(objectname:short)" > branches.list
    rm -f tests.list
    for F in $SRC
    do
        echo "$F" >> tests.list
    done
fi

# Opt-in: render the SAME 3.x inputs with the selected Studio executable.
# Keep complete pages under html/reference-studio/, plus a version/score manifest.
# The tracked 3.x vtest/*-ref.png files are never changed.
if [ "$RUN_MODERN" = "1" ]; then
      echo "Generate MuseScore Studio reference PNGs"
      python3 "$SCRIPT_DIR/render-studio-references.py" \
            --mscore "$VTEST_REFERENCE_MSCORE" --scores-dir "$DIR" \
            --html-dir "$DIR/html" --dpi "$DPI" --inputs-manifest "$INPUT_MANIFEST" $REFRESH_ARGS $SRC || exit 1
fi

# Optional third renderer. Keep its input independent of the controlled
# Studio/37E profiles so the historical score-loading behavior is visible.
if [ "$RUN_HISTORICAL" = "1" ]; then
      echo "Generate independent historical MuseScore reference PNGs"
      python3 "$SCRIPT_DIR/render-historical-references.py" \
            --mscore "$VTEST_HISTORICAL_MSCORE" --html-dir "$DIR/html" \
            --inputs-manifest "$INPUT_MANIFEST" --dpi "$DPI" $REFRESH_ARGS $SRC || exit 1
fi

# Optional 37E beam-layout A/B variants, requested through VTEST_BEAM_AB=1.
# Only generated for Studio comparisons; raw/historical mode never
# modifies a canonical input or produces an A/B report.
if [ "$RUN_MODERN" = "1" ]; then
      echo "Render configured 37E legacy beam variants"
      python3 "$SCRIPT_DIR/render-beam-legacy.py" \
            --mscore "$MSCORE" --html-dir "$DIR/html" \
            --inputs-manifest "$INPUT_MANIFEST" --dpi "$DPI" $SRC || exit 1
fi

echo "Compare PNG files and references"
# Never reuse a Studio page-1 reference when --modern was not requested.
# With --historical alone, the historical renderer is the primary reference.
for src in $SRC; do
      if [ "$RUN_MODERN" = "1" ]; then
            : # Studio renderer has prepared $src-ref.png.
      elif [ "$RUN_HISTORICAL" = "1" ]; then
            cp "reference-historical/$src-1.png" "$src-ref.png" || exit 1
      elif [ -f "../$src-ref.png" ]; then
            cp "../$src-ref.png" "$src-ref.png" || exit 1
      else
            rm -f "$src-ref.png"
      fi
      if [ -s "$src-ref.png" ]; then
            compare -verbose -metric AE "$src-1.png" "$src-ref.png" "$src-diff.png" || :
      fi
done >LOG-compare 2>&1

echo "Generate report"
F=vtest.html
rm -f $F
cp ../style.css .
echo "<html>" >> $F
echo "  <head>" >> $F
echo "   <link rel=\"stylesheet\" type=\"text/css\" href=\"style.css\">" >> $F
echo "  </head>" >> $F
echo "  <body>" >> $F
echo "    <div id=\"topbar\">" >> $F
echo "      <span>After PR</span>" >> $F
echo "      <span>Before PR</span>" >> $F
echo "      <span>Comparison</span>" >> $F
echo "    </div>" >> $F
echo "    <div id=\"topmargin\"></div>" >> $F
for src in $SRC; do
      echo "    <h2 id=\"$src\">$src <a class=\"toc-anchor\" href=\"#$src\">#</a></h2>" >> $F
      echo "    <div>" >> $F
      echo "      <img src=\"$src-1.png\">" >> $F
      if [ -f "$src-ref.png" ]; then
            echo "      <img src=\"$src-ref.png\">" >> $F
            echo "      <img src=\"$src-diff.png\">" >> $F
      fi
      echo "    </div>" >> $F
      done
echo "  </body>" >> $F
echo "</html>" >> $F

# Always produce a useful enhanced report, even for scores without bundled
# references. A baseline still compares before/current 37E when compatible.
echo "Generate background-normalized engraving report"
BASELINE_ARGS=""
if [ -f "$DIR/baselines/37e/manifest.json" ]; then
      BASELINE_ARGS="--baseline-manifest=$DIR/baselines/37e/manifest.json"
fi
if [ "$RUN_MODERN" = "1" ]; then
      HISTORICAL_ARGS=""
      if [ "$RUN_HISTORICAL" = "1" ]; then
            HISTORICAL_ARGS="--historical-manifest=$DIR/html/reference-historical/manifest.json"
      fi
      python3 "$SCRIPT_DIR/compare-engraving.py" \
            --reference-manifest "$DIR/html/reference-studio/manifest.json" \
            --html-dir "$DIR/html" --scores-dir "$DIR" \
            --inputs-manifest "$INPUT_MANIFEST" $BASELINE_ARGS \
            --beam-manifest "$DIR/html/beam-legacy/manifest.json" \
            $HISTORICAL_ARGS $SRC || exit 1
elif [ "$RUN_HISTORICAL" = "1" ]; then
      python3 "$SCRIPT_DIR/compare-engraving.py" \
            --reference-manifest "$DIR/html/reference-historical/manifest.json" \
            --primary-historical \
            --html-dir "$DIR/html" --scores-dir "$DIR" \
            --inputs-manifest "$INPUT_MANIFEST" $BASELINE_ARGS $SRC || exit 1
else
      python3 "$SCRIPT_DIR/compare-engraving.py" --html-dir "$DIR/html" \
            --scores-dir "$DIR" --inputs-manifest "$INPUT_MANIFEST" \
            --optional-bundled-reference $BASELINE_ARGS $SRC || exit 1
fi
F=engraving.html
if [ ! -f "$F" ]; then
      echo "ERROR: engraving report was not generated in $(pwd)" >&2
      exit 1
fi
echo "Open engraving report: $(pwd)/$F"

echo $BROWSER

$BROWSER $F 2>/dev/null
